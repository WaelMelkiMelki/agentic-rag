GEMINI_API_KEY=your_key_here
OPENROUTER_API_KEY=your_key_here
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
LANGFUSE_PUBLIC_KEY=pk-lf-xxx
LANGFUSE_SECRET_KEY=sk-lf-xxx
LANGFUSE_HOST=https://cloud.langfuse.com
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Ollama-first routing: local Ollama is tried before Gemini/OpenRouter.
# Set OLLAMA_ENABLED=false to skip Ollama (e.g. on Render with no Ollama endpoint).
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=60
QDRANT_URL=https://xxxxx.eu-west-1-0.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=yyyyyy
